# Application database. Use a separate, least-privileged database user in production.
DATABASE_URL=postgresql://trimtime_dev:trimtime_dev_only@127.0.0.1:5433/trimtime_dev

# Used only by `pnpm db:migrate`; keep it separate when migration privileges differ.
MIGRATION_DATABASE_URL=postgresql://trimtime_dev:trimtime_dev_only@127.0.0.1:5433/trimtime_dev

# Opt in to local-only email capture after starting the Mailpit compose service.
EMAIL_MODE=mailpit
MAILPIT_ORIGIN=http://127.0.0.1:8025

# Local HTTPS origins. Generate trusted certificates before running pnpm dev:https.
MARKETING_ORIGIN=https://localtest.me:3000
APP_ORIGIN=https://app.localtest.me:3000
# Optional; when omitted, Better Auth uses APP_ORIGIN. If set, it must match.
# BETTER_AUTH_URL=https://app.localtest.me:3000

# Generate a long random value; never commit the real secret.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# 32 random bytes encoded as base64; keep this key and ID outside PostgreSQL.
BOOKING_CAPABILITY_KEY_ID=local-v1
BOOKING_CAPABILITY_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Google OAuth web-client credentials. Register the exact callback generated by Better Auth.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
