{
  "name": "trimtime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key ./certs/local/trimtime-local-key.pem --experimental-https-cert ./certs/local/trimtime-local.pem --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:db": "node --env-file=.env.test scripts/test-db.mjs test",
    "db:test:up": "node scripts/test-db.mjs up",
    "db:dev:up": "docker compose --project-name trimtime-dev -f compose.dev.yml up --detach --wait",
    "db:dev:stop": "docker compose --project-name trimtime-dev -f compose.dev.yml stop db",
    "db:test:stop": "node scripts/test-db.mjs stop",
    "db:test:down": "node scripts/test-db.mjs down",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@fullcalendar/react": "7.1.2",
    "@vercel/functions": "3.10.1",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "temporal-polyfill": "1.0.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
